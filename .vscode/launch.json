{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Catalog App (Windows Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "catalog",
      "args": [
        "-d",
        "windows",
        "--dart-define-from-file=../.env"
      ]
    },
    {
      "name": "Catalog App (Windows Profile)",
      "request": "launch",
